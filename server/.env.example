# Server Port (Render automatically sets PORT)
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas URI)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bit_stationery_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bit_stationery_db

# JWT Secret for Session Tokens
JWT_SECRET=bit_campus_stationery_super_secret_jwt_key_2026

# Environment Mode
NODE_ENV=production

# Allowed Frontend URL(s) for CORS (comma-separated, or leave blank to allow all)
CLIENT_URL=https://your-frontend-app.vercel.app
